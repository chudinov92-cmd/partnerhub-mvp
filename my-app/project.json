{
  "name": "my-app",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "my-app/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "my-app",
        "tty": false,
        "command": "next build --webpack"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "my-app",
        "command": "next dev --webpack"
      }
    }
  }
}