# CSP отдаёт Next.js (middleware). Здесь — TLS-терминатор + HSTS, X-Frame-Options, rate-limit IP на Auth.
# Не дублируйте Content-Security-Policy здесь — иначе возможны конфликтующие политики.

(common_security_headers) {
  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

zeip.ru, www.zeip.ru {
  import common_security_headers
  encode gzip zstd
  reverse_proxy 127.0.0.1:3001
}

test.zeip.ru {
  import common_security_headers
  encode gzip zstd
  reverse_proxy 127.0.0.1:3002
}

# Kong: HTTP :8000. Caddy снимает TLS — проксируем на :8000 с реальным IP клиента.
supabase.zeip.ru {
  import common_security_headers
  encode gzip zstd
  reverse_proxy 127.0.0.1:8000 {
    header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
    header_up X-Real-IP {remote_host}
  }
}
