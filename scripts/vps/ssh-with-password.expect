#!/usr/bin/expect -f
# VPS_SSH_PASSWORD='...' expect scripts/vps/ssh-with-password.expect root@host /path/script.sh [args...]
set timeout 1800
if {![info exists env(VPS_SSH_PASSWORD)] || $env(VPS_SSH_PASSWORD) eq ""} {
  puts stderr "VPS_SSH_PASSWORD не задан"
  exit 2
}
set host [lindex $argv 0]
set script_path [lindex $argv 1]
set extra_args [lrange $argv 2 end]
if {$host eq "" || $script_path eq ""} {
  puts stderr "Usage: VPS_SSH_PASSWORD=... expect ssh-with-password.expect user@host script.sh [args...]"
  exit 2
}
set fp [open $script_path r]
set body [read $fp]
close $fp
set remote_cmd "bash -s"
foreach a $extra_args {
  append remote_cmd " [string map {\\ \\\\ \" \\\"} $a]"
}
spawn ssh -o StrictHostKeyChecking=accept-new $host $remote_cmd
expect {
  -re "(?i)password:" {
    send -- "$env(VPS_SSH_PASSWORD)\r"
    exp_continue
  }
  -re "Permission denied" {
    puts stderr "SSH auth failed"
    exit 1
  }
  -re "Connection closed by remote host" {
    puts stderr "SSH connection closed (неверный пароль или fail2ban?)"
    exit 1
  }
  -re "closed by remote host" {
    puts stderr "SSH connection closed (неверный пароль или fail2ban?)"
    exit 1
  }
  timeout {
    puts stderr "timeout waiting for SSH auth"
    exit 1
  }
}
send $body
send "\x04"
expect {
  eof {}
  timeout {
    puts stderr "timeout waiting for remote script"
    exit 1
  }
}
catch wait result
set code [lindex $result 3]
if {$code eq ""} { set code 0 }
exit $code
